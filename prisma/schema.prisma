datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  STAFF
}

enum ExpenseStatus {
  PENDING
  WARNING
  APPROVED
  REJECTED
}

enum ExpenseType {
  RECEIPT
  PAYMENT_VOUCHER
  GENERAL
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

enum VatCategory {
  G
  S
}

enum CategoryType {
  OPERATIONAL
  ADMINISTRATIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  phoneNumber    String?
  passwordHash   String
  role           UserRole
  organizationId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expenseBases         ExpenseBase[]     @relation("ExpenseBaseCreatedBy")
  invitationsSent      Invitation[]      @relation("InvitationSender")
  refundsRequested     Refund[]          @relation("RefundRequester")
  approvalHistory      ApprovalHistory[]
  activityLogs         ActivityLog[]
  organizationsCreated Organization[]    @relation("OrganizationCreator")

  @@index([organizationId])
  @@index([email])
  @@index([role])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy       User            @relation("OrganizationCreator", fields: [createdById], references: [id])
  users           User[]
  expenseBases    ExpenseBase[]
  invitations     Invitation[]
  categories      Category[]
  unitsOfMeasure  UnitOfMeasure[]
  purchaseTypes   PurchaseType[]
  bankAccounts    BankAccount[]
  expensePolicies ExpensePolicy[]
  refunds         Refund[]
  activityLogs    ActivityLog[]

  @@index([name])
  @@index([createdById])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           UserRole
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String
  invitedAt      DateTime         @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([organizationId])
  @@index([status])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  type           CategoryType @default(OPERATIONAL)
  description    String?
  isActive       Boolean      @default(true)

  // Relations
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptExpenseItems ReceiptExpenseItem[]
  paymentVoucherItems PaymentVoucherItem[]
  generalExpenses     GeneralExpense[]

  @@unique([organizationId, type, name])
  @@index([organizationId])
  @@index([name])
}

model ExpensePolicy {
  id                String   @id @default(uuid())
  organizationId    String
  policyName        String
  description       String?
  maxAmount         Float?
  allowedCategories Json? // Array of category IDs
  requiresReceipt   Boolean  @default(false)
  autoApprove       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ExpenseBase {
  id              String        @id @default(uuid())
  organizationId  String
  createdByUserId String
  expenseType     ExpenseType
  status          ExpenseStatus @default(PENDING)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             User                   @relation("ExpenseBaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  approvalHistory       ApprovalHistory[]
  receiptExpense        ReceiptExpense?
  paymentVoucherExpense PaymentVoucherExpense?
  generalExpense        GeneralExpense?

  @@index([organizationId])
  @@index([createdByUserId])
  @@index([expenseType])
  @@index([status])
  @@index([createdAt])
}

model ReceiptExpense {
  id            String @id @default(uuid())
  expenseBaseId String @unique

  purchasedDate DateTime
  companyName   String
  tinNumber     String?
  fsNumber      String?
  mrcNumber     String?
  invoiceNumber String?
  paymentMethod PaymentMethod
  checkNumber   String?
  bankAccountId String?

  subtotal Decimal @db.Decimal(12, 2)
  vat      Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  // Relations
  expenseBase ExpenseBase          @relation(fields: [expenseBaseId], references: [id], onDelete: Cascade)
  bankAccount BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  items       ReceiptExpenseItem[]

  @@index([expenseBaseId])
  @@index([purchasedDate])
}

model ReceiptExpenseItem {
  id                 String      @id @default(uuid())
  receiptExpenseId   String
  itemName           String
  categoryId         String
  vatCategory        VatCategory @default(G)
  quantity           Decimal     @db.Decimal(12, 2)
  unitPrice          Decimal     @db.Decimal(12, 2)
  lineTotal          Decimal     @db.Decimal(12, 2)
  unitOfMeasureId    String?
  purchaseTypeId     String?
  hasPolicyViolation Boolean     @default(false)

  // Relations
  receiptExpense ReceiptExpense @relation(fields: [receiptExpenseId], references: [id], onDelete: Cascade)
  category       Category       @relation(fields: [categoryId], references: [id])
  unitOfMeasure  UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])
  purchaseType   PurchaseType?  @relation(fields: [purchaseTypeId], references: [id])

  @@index([receiptExpenseId])
  @@index([categoryId])
}

model PaymentVoucherExpense {
  id            String        @id @default(uuid())
  expenseBaseId String        @unique
  invoiceNumber String
  purchasedDate DateTime
  paidTo        String
  tinNumber     String?
  totalAmount   Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  checkNumber   String?
  bankAccountId String?

  expenseBase ExpenseBase          @relation(fields: [expenseBaseId], references: [id], onDelete: Cascade)
  bankAccount BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  items       PaymentVoucherItem[]
}

model PaymentVoucherItem {
  id               String  @id @default(uuid())
  paymentVoucherId String
  itemName         String
  quantity         Decimal @db.Decimal(12, 2)
  unitPrice        Decimal @db.Decimal(12, 2)
  lineTotal        Decimal @db.Decimal(12, 2)
  categoryId       String

  paymentVoucher PaymentVoucherExpense @relation(fields: [paymentVoucherId], references: [id], onDelete: Cascade)
  category       Category              @relation(fields: [categoryId], references: [id])
}

model GeneralExpense {
  id            String @id @default(uuid())
  expenseBaseId String @unique

  paymentDate   DateTime
  paidTo        String
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  checkNumber   String?
  bankAccountId String?
  categoryId    String

  expenseBase ExpenseBase  @relation(fields: [expenseBaseId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  category    Category     @relation(fields: [categoryId], references: [id])
}

model BankAccount {
  id String @id @default(uuid())

  // Multi-tenant support
  organizationId String

  // Bank details
  bankName          String
  accountHolderName String
  accountNumber     String
  initialBalance    Decimal @default(0) @db.Decimal(14, 2)
  balance           Decimal @default(0) @db.Decimal(14, 2)

  // Soft delete / status
  isActive Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptExpenses        ReceiptExpense[]
  paymentVoucherExpenses PaymentVoucherExpense[]
  generalExpenses        GeneralExpense[]
  refundsFrom            Refund[]                @relation("RefundFromAccount")
  refundsTo              Refund[]                @relation("RefundToAccount")

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model Refund {
  id              String       @id @default(uuid())
  organizationId  String
  requesterId     String
  fromAccountId   String
  toAccountId     String
  amount          Decimal      @db.Decimal(14, 2)
  remark          String
  rejectionReason String       @default("")
  status          RefundStatus @default(PENDING)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime     @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("RefundRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  fromAccount  BankAccount  @relation("RefundFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount    BankAccount  @relation("RefundToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([requesterId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([status])
  @@index([createdAt])
}

model UnitOfMeasure {
  id             String   @id @default(uuid())
  organizationId String
  label          Int
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptExpenseItems ReceiptExpenseItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model PurchaseType {
  id             String   @id @default(uuid())
  organizationId String
  label          Int
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptExpenseItems ReceiptExpenseItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model ApprovalHistory {
  id            String         @id @default(uuid())
  expenseBaseId String
  action        ApprovalAction
  comment       String?
  performedById String
  createdAt     DateTime       @default(now())

  // Relations
  expenseBase ExpenseBase @relation(fields: [expenseBaseId], references: [id], onDelete: Cascade)
  performedBy User        @relation(fields: [performedById], references: [id], onDelete: Cascade)

  @@index([expenseBaseId])
  @@index([performedById])
  @@index([createdAt])
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  actionType     String
  entityType     String
  entityId       String
  previousValue  Json?
  newValue       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
