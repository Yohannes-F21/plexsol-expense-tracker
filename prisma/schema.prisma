datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  STAFF
}

enum ExpenseStatus {
  PENDING
  WARNING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

enum VatCategory {
  G
  S
}

enum CategoryType {
  OPERATIONAL
  ADMINISTRATIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  phoneNumber       String?
  passwordHash      String
  role              UserRole
  organizationId    String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  expenses          Expense[] @relation("UserCreatedExpenses")
  invitationsSent   Invitation[] @relation("InvitationSender")
  refundsRequested  Refund[] @relation("RefundRequester")
  approvalHistory   ApprovalHistory[]
  activityLogs      ActivityLog[]
  organizationsCreated Organization[] @relation("OrganizationCreator")
  
  @@index([organizationId])
  @@index([email])
  @@index([role])
}

model Organization {
  id                String   @id @default(uuid())
  name              String
  industry          String?
  isActive          Boolean  @default(true)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  createdBy         User @relation("OrganizationCreator", fields: [createdById], references: [id])
  users             User[]
  expenses          Expense[]
  invitations       Invitation[]
  categories        Category[]
  unitsOfMeasure    UnitOfMeasure[]
  purchaseTypes     PurchaseType[]
  bankAccounts      BankAccount[]
  expensePolicies   ExpensePolicy[]
  refunds           Refund[]
  activityLogs      ActivityLog[]
  
  @@index([name])
  @@index([createdById])
}

model Invitation {
  id                String   @id @default(uuid())
  organizationId    String
  email             String
  role              UserRole
  token             String   @unique
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime
  invitedById       String
  invitedAt         DateTime @default(now())
  
  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy         User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  
  @@index([email])
  @@index([token])
  @@index([organizationId])
  @@index([status])
}

model Category {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  type              CategoryType @default(OPERATIONAL)
  description       String?
  isActive          Boolean  @default(true)
  
  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseItems      ExpenseItem[]
  
  @@unique([organizationId, type, name])
  @@index([organizationId])
  @@index([name])
}

model ExpensePolicy {
  id                String   @id @default(uuid())
  organizationId    String
  policyName        String
  description       String?
  maxAmount         Float?
  allowedCategories Json?    // Array of category IDs
  requiresReceipt   Boolean  @default(false)
  autoApprove       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  
  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
}

model Expense {
  id                String   @id @default(uuid())
  purchasedDate     DateTime @default(now())
  companyName       String   @default("")
  tinNumber         String   @default("")
  fsNumber          String   @default("")
  mrcNumber         String?
  invoiceNumber     String?
  paymentMethod     PaymentMethod @default(OTHER)
  checkNumber       String?
  bankAccountId     String?
  subtotal          Decimal  @default(0) @db.Decimal(12, 2)
  vat               Decimal  @default(0) @db.Decimal(12, 2)
  total             Decimal  @default(0) @db.Decimal(12, 2)
  status            ExpenseStatus @default(PENDING)
  approvedAt        DateTime?
  createdByUserId   String
  organizationId    String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  createdByUser     User @relation("UserCreatedExpenses", fields: [createdByUserId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  items             ExpenseItem[]
  approvalHistory   ApprovalHistory[]
  
  @@index([createdByUserId])
  @@index([organizationId])
  @@index([bankAccountId])
  @@index([status])
  @@index([purchasedDate])
  @@index([createdAt])
}

model BankAccount {
  id                String   @id @default(uuid())

  // Multi-tenant support
  organizationId    String

  // Bank details
  bankName          String
  accountHolderName String
  accountNumber     String
  initialBalance    Decimal  @default(0) @db.Decimal(14, 2)
  balance           Decimal  @default(0) @db.Decimal(14, 2)

  // Soft delete / status
  isActive          Boolean  @default(true)

  // Audit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  refundsFrom       Refund[]     @relation("RefundFromAccount")
  refundsTo         Refund[]     @relation("RefundToAccount")

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model Refund {
  id             String        @id @default(uuid())
  organizationId String
  requesterId    String
  fromAccountId  String
  toAccountId    String
  amount         Decimal       @db.Decimal(14, 2)
  remark         String
  rejectionReason String       @default("")
  status         RefundStatus  @default(PENDING)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime      @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("RefundRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  fromAccount  BankAccount  @relation("RefundFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount    BankAccount  @relation("RefundToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([requesterId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([status])
  @@index([createdAt])
}

model ExpenseItem {
  id                String   @id @default(uuid())
  expenseId         String
  itemName          String
  subcategoryId     String
  vatCategory       VatCategory @default(G)
  quantity          Decimal  @db.Decimal(12, 2)
  unitPrice         Decimal  @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  unitOfMeasureId   String?
  purchaseTypeId    String?
  hasPolicyViolation Boolean @default(false)

  // Relations
  expense           Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  subcategory       Category @relation(fields: [subcategoryId], references: [id])
  unitOfMeasure     UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])
  purchaseType      PurchaseType? @relation(fields: [purchaseTypeId], references: [id])

  @@index([expenseId])
  @@index([subcategoryId])
}

model UnitOfMeasure {
  id             String   @id @default(uuid())
  organizationId String
  label          Int
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseItems   ExpenseItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model PurchaseType {
  id             String   @id @default(uuid())
  organizationId String
  label          Int
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseItems   ExpenseItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model ApprovalHistory {
  id            String         @id @default(uuid())
  expenseId     String
  action        ApprovalAction
  comment       String?
  performedById String
  createdAt     DateTime       @default(now())

  // Relations
  expense       Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  performedBy   User    @relation(fields: [performedById], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([performedById])
  @@index([createdAt])
}

model ActivityLog {
  id                String   @id @default(uuid())
  userId            String
  organizationId    String?
  actionType        String
  entityType        String
  entityId          String
  previousValue     Json?
  newValue          Json?
  ipAddress         String?
  createdAt         DateTime @default(now())
  
  // Relations
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
